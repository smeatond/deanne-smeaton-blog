---
import { Image } from "astro:assets";
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import siteLogo from "../assets/branding/ds-logo-lightmode-sml.svg";
---

<header>
	
		<a href="/" class="logo-link">
            <Image
				src={siteLogo}
				class="logo"
				alt="Deanne Smeaton"
				title="Deanne Smeaton"
			/>
        </a>
			<div class="site-title">
				<span class="title">{SITE_TITLE}</span>
				<span class="sub-title">{SITE_DESCRIPTION}</span>
			</div>
			<nav>	
				<div class="internal-links">
					<HeaderLink href="/">Home</HeaderLink>
					<HeaderLink href="/about">About Me</HeaderLink>
					<HeaderLink href="/blog">Blog</HeaderLink>
					
				
			</div>
		
	</nav>
	
</header>
<style>

	/**HEADER STYLES **/

	header {

		display: grid;
		grid-template-columns: 1fr 8fr 3fr;
		margin: 0;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
		align-items: end;
    gap: 1rem;
}

  .logo {
	width: 9rem;
	height: auto;
  }
  
  .site-title {
	display: grid;
	grid-template-rows: auto auto;
  }
  
  .header-section {
	margin-left: 0.5rem;
  }
  .title {
	font-weight: bold;
	font-family: "Fira Code";
	font-size: 2rem;
  }
  
  .sub-title {
	font-size: 1rem;
  }
  
  .nav {
	grid-area: nav;
	padding: 0;
  }
  
  .nav ul {
	list-style: none;
	display: grid;
	grid-template-columns: repeat(3, auto);
	padding: 0.5rem 0;
	margin: 0;
	justify-items: center;
  }
	
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
