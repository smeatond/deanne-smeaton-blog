---
import Layout from '../layouts/Page.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION} >

	<section>
		<h1 lang="mi">Kia ora</h1>
		<p>
			<span lang="mi">Kia ora</span> and welcome! I'm Deanne, a full-stack developer and 
			technical lead based in Mid Canterbury, New Zealand. I've spent over a decade building software, 
			solving problems, and working across the stack.
		</p>
		<p>
			This is my little corner of the web, where you can find out more about me and my work. 
			For a little more insight into my journey, have a look at 
			the <a href="/about">About Me</a> section, or explore my latest posts below.
		</p>
	</section>
	<section>
		<h2>Latest Blog Posts</h2>
		<p>Watch this space, this is coming soon!</p>
	</section>
</Layout>
