---

import Layout from '../../layouts/Page.astro';

import { SITE_TITLE } from '../../consts';

import { getCollection } from 'astro:content';

import { Image } from 'astro:assets';

import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(

	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()

);

---

<Layout

	title={`${SITE_TITLE}: Blog`}
	description="Deanne Smeaton's blog, featuring thoughts, ideas, and learnings."

>

	<section>
		<h1>Latest Posts</h1>
		<ul class="blog-list">
			{
				posts.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`}>
							<div class="image-wrapper">
								{post.data.heroImage && (
									<Image
										width={720}
										height={240}
										src={post.data.heroImage}
										alt=""
									/>
								)}
								<time datetime={post.data.pubDate.toISOString()}>
									<FormattedDate date={post.data.pubDate} />
								</time>
							</div>
							<div class="card-content">
								<h2>{post.data.title}</h2>
								<div class="tags">
									{post.data.tags?.map((tag) => (
										<span class="tag">{tag}</span>
									))}
								</div>
								<p class="description">
									{post.data.description}
								</p>
							</div>
						</a>
					</li>
				))
			}
		</ul>
	</section>

</Layout>

<style>

	.blog-list {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.blog-list li {
		width: 100%;
	}
	.blog-list li a {
		display: grid;
		grid-template-columns: 45% 1fr;
		gap: 2rem;
		color: inherit;
		text-decoration: none;
	}
	.image-wrapper {
		position: relative;
	}
	.image-wrapper img {
		display: block;
		width: 100%;
		aspect-ratio: 2 / 1;
		object-fit: cover;
		border-radius: 12px;
		transition: box-shadow 0.2s ease;
	}
	.blog-list li a:hover img {
		box-shadow: var(--box-shadow);
	}
	.image-wrapper time {
		position: absolute;
		right: 0.75rem;
		bottom: 0.75rem;
		padding: 0.35rem 0.65rem;
		border-radius: 6px;
		background: rgb(var(--white));
		background-color: white;
		color: rgb(var(--gray-dark));
		font-size: 0.8rem;
	}
	.card-content {
		padding-top: 0.25rem;
	}
	.card-content h2 {
		margin: 0 0 0.75rem;
		font-size: 2rem;
		line-height: 1.2;
	}
	
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-bottom: 0.75rem;
	}
	.tag {
		padding: 0.25rem 0.6rem;
		border-radius: 999px;
		background: rgb(var(--gray-light));
		color: rgb(var(--gray-dark));
		font-size: 0.8rem;
	}
	.description {
		margin: 0;
		color: rgb(var(--gray));
		line-height: 1.5;
	}

	.blog-list li a {

display: grid;
grid-template-columns: 32% 1fr;
gap: 2rem;
color: inherit;
text-decoration: none;
border-radius: 12px;
transition: box-shadow 0.2s ease;

}

.blog-list li a:hover {

box-shadow: var(--box-shadow);

}
	@media (max-width: 720px) {
		.blog-list li a {
			grid-template-columns: 1fr;
			gap: 1rem;
		}
		.card-content {
			padding-top: 0;
		}
	}

</style>